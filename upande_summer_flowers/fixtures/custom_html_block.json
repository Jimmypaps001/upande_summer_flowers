  "doctype": "Custom HTML Block",
  "html": "<div class=\"sfn\">\n  <div class=\"sfn-hero\"><div class=\"sfn-hero-tt\">Summer Flowers</div><div class=\"sfn-hero-sub\">demand &middot; procure &middot; propagate &middot; plant &middot; cut</div></div>\n  <div class=\"sfn-title\">Start here</div>\n  <div class=\"sfn-grid\">\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/summer-flowers-planning\">\n      <span class=\"sfn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21a9 9 0 1 0-9-9\"/><path d=\"M3 12h2M12 3v2M20.5 7.5 19 9\"/><path d=\"m12 12 5-3\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Planning Dashboard</span><span class=\"sfn-sub\">Demand, plans, approvals</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/summer-flowers-overview\">\n      <span class=\"sfn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12 2 9 5-9 5-9-5 9-5z\"/><path d=\"m3 12 9 5 9-5\"/><path d=\"m3 17 9 5 9-5\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Season Overview</span><span class=\"sfn-sub\">Where every variety stands</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/crop-cycles\">\n      <span class=\"sfn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Crop Cycle Board</span><span class=\"sfn-sub\">What is in the ground</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/summer-flowers-flow\">\n      <span class=\"sfn-ic\" style=\"background:rgba(59,130,246,.13);color:#3b82f6\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"6\" cy=\"19\" r=\"3\"/><circle cx=\"18\" cy=\"5\" r=\"3\"/><path d=\"M9 19h6a4 4 0 0 0 4-4V8\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">How Planning Works</span><span class=\"sfn-sub\">The chain, end to end</span></span>\n    </a>\n  </div>\n  <div class=\"sfn-title\">Demand and plan</div>\n  <div class=\"sfn-grid\">\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-market-demand\" data-count=\"Summer Flower Market Demand\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"3 17 9 11 13 15 21 7\"/><polyline points=\"15 7 21 7 21 13\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Market Demand</span><span class=\"sfn-sub\">Stems the market wants</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-production-plan\" data-count=\"Summer Flower Production Plan\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"8\" y=\"3\" width=\"8\" height=\"4\" rx=\"1\"/><path d=\"M16 5h2a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2\"/><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"/><line x1=\"8\" y1=\"16\" x2=\"13\" y2=\"16\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Production Plan</span><span class=\"sfn-sub\">Plants, beds and weeks</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-production-plan?workflow_state=Pending%20Approval\" data-count=\"Summer Flower Production Plan\" data-filters='{\"workflow_state\": \"Pending Approval\"}' data-warn>\n      <span class=\"sfn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Awaiting Approval</span><span class=\"sfn-sub\">Waiting on a manager</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-season-plan\" data-count=\"Summer Flower Season Plan\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/><line x1=\"8\" y1=\"3\" x2=\"8\" y2=\"7\"/><line x1=\"16\" y1=\"3\" x2=\"16\" y2=\"7\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Season Plan</span><span class=\"sfn-sub\">Receive, plant, deliver</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-budget\" data-count=\"Summer Flower Budget\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(139,92,246,.13);color:#7c53e0\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/><path d=\"M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6\"/><path d=\"M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Revenue Budget</span><span class=\"sfn-sub\">What the season earns</span></span>\n    </a>\n  </div>\n  <div class=\"sfn-title\">Buy and propagate</div>\n  <div class=\"sfn-grid\">\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-procurement-plan\" data-count=\"Summer Flower Procurement Plan\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 6h15l-1.5 9h-12z\"/><circle cx=\"9\" cy=\"20\" r=\"1\"/><circle cx=\"18\" cy=\"20\" r=\"1\"/><path d=\"M6 6 5 3H2\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Procurement Plan</span><span class=\"sfn-sub\">What to buy, and when</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-propagation-plan\" data-count=\"Summer Flower Propagation Plan\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22V10\"/><path d=\"M12 12C12 8 9 5 4 5c0 5 3 7 8 7z\"/><path d=\"M12 14c0-3.5 2.5-6 7-6 0 4.5-2.5 6-7 6z\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Propagation Plan</span><span class=\"sfn-sub\">Arrival and delivery weeks</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/summer-flower-motherstock-batch\" data-count=\"Summer Flower Motherstock Batch\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"7\" r=\"3\"/><path d=\"M12 10v11\"/><path d=\"M12 14 7 18M12 14l5 4\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Motherstock Batches</span><span class=\"sfn-sub\">Mothers standing, and cuts</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/seedling-request\" data-count=\"Seedling Request\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"9\" y1=\"4\" x2=\"9\" y2=\"20\"/><line x1=\"15\" y1=\"4\" x2=\"15\" y2=\"20\"/><line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Seedling Requests</span><span class=\"sfn-sub\">What the nursery raises</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/propagation-batch\" data-count=\"Propagation Batch\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(34,197,94,.13);color:#16a34a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8l-9-5-9 5 9 5 9-5z\"/><path d=\"M3 8v8l9 5 9-5V8\"/><path d=\"M12 13v8\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Propagation Batches</span><span class=\"sfn-sub\">Trays on the bench</span></span>\n    </a>\n  </div>\n  <div class=\"sfn-title\">Plant and grow</div>\n  <div class=\"sfn-grid\">\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/planting-calendar\" data-count=\"Planting Calendar\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"/><line x1=\"8\" y1=\"3\" x2=\"8\" y2=\"7\"/><line x1=\"16\" y1=\"3\" x2=\"16\" y2=\"7\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Planting Calendar</span><span class=\"sfn-sub\">Which bed, which week</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/crop-cycle\">\n      <span class=\"sfn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M11 20A7 7 0 0 1 4 13c0-6 7-9 16-9 0 9-4 15-9 16z\"/><path d=\"M4 21c3-6 7-9 11-11\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Crop Cycles</span><span class=\"sfn-sub\">Standing crops</span></span>\n    </a>\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/bed-work-order\" data-count=\"Bed Work Order\" data-filters='{\"status\": [\"in\", [\"Not Started\", \"In Progress\", \"Paused\"]]}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(16,185,129,.13);color:#059669\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a4 4 0 0 0 5 5L21 21H3l6-9\"/><circle cx=\"8\" cy=\"6\" r=\"3\"/></svg></span>\n      <span class=\"sfn-tx\"><span class=\"sfn-lb\">Bed Work Orders</span><span class=\"sfn-sub\">Prepare, plant, uproot</span></span>\n    </a>\n  </div>\n  <div class=\"sfn-title\">Blocks and beds</div>\n  <div class=\"sfn-grid\">\n    <a class=\"sfn-tile\" data-roles=\"\" href=\"/app/block\" data-count=\"Block\" data-filters='{}'>\n      <span class=\"sfn-ic\" style=\"background:rgba(6,182,212,.13);color:#0891b2\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy