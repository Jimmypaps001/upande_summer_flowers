   "default": "0",
   "fieldname": "capped_by_space",
   "fieldtype": "Check",
   "label": "Order trimmed to fit",
   "read_only": 1
  },
  {
   "fieldname": "space_note",
   "fieldtype": "Small Text",
   "label": "Note",
   "read_only": 1
  },
  {
   "fieldname": "section_totals",
   "fieldtype": "Section Break",
   "label": "Totals"
  },
  {
   "fieldname": "total_plants_at_field",
   "fieldtype": "Int",
   "label": "Plants to Stand",
   "read_only": 1
  },
  {
   "description": "Everything bought by this plan. On a crop raised through a motherstock that is one purchase -- the plantlets on the Establishment line -- not one per planting.",
   "fieldname": "total_units_to_order",
   "fieldtype": "Int",
   "in_list_view": 1,
   "label": "Units to Order",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.peak_cuttings",
   "description": "The busiest sticking week. The pool is bought once and cut from every week, so this is what sizes the order -- the weeks either side lend it nothing.",
   "fieldname": "peak_cuttings",
   "fieldtype": "Int",
   "label": "Peak Week Cuttings",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.peak_cuttings",
   "description": "The week that figure falls in.",
   "fieldname": "peak_week",
   "fieldtype": "Data",
   "label": "Peak Week",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.peak_cuttings",
   "description": "The plantlets plus one for each multiplication. The peak is divided by this: 70,000 cuttings is 70,000 plantlets at no multiplication, 35,000 at one, 23,333 at two.",
   "fieldname": "generations",
   "fieldtype": "Float",
   "label": "Generations Standing",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.peak_cuttings",
   "description": "How long the pool can be cut from. Each multiplication is one establishment spent reaching the full pool, taken out of the line's life rather than added to it, because the block is cleared one life after its FIRST cut.",
   "fieldname": "cutting_weeks_left",
   "fieldtype": "Int",
   "label": "Cutting Weeks Left",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.peak_cuttings",
   "description": "Worked out, not chosen: the most multiplication whose pool still outlasts the season. Every extra one is plantlets saved, so the cheapest workable answer is the last one that still covers the sticking weeks.",
   "fieldname": "cycles_suggested",
   "fieldtype": "Int",
   "label": "Multiplications Suggested",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.pool_plants",
   "description": "Plantlets x generations. This is what has to be standing in the peak week.",
   "fieldname": "pool_plants",
   "fieldtype": "Int",
   "hidden": 0,
   "label": "Mother Plants The Order Becomes",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.pool_plants",
   "description": "Moved to the Motherstock Plan, which is where the line is worked out week by week. Kept so older plans and reports still read back.",
   "fieldname": "weekly_draw",
   "fieldtype": "Int",
   "hidden": 1,
   "label": "Cuttings a week at the peak",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.motherstock_plan",
   "description": "The line week by week: when each generation starts cutting, what the cut is split into, and whether the field gets what it asks for. Open it to change the plantlets or the diversion and see what happens.",
   "fieldname": "motherstock_plan",
   "fieldtype": "Link",
   "label": "Motherstock Plan",
   "options": "Summer Flower Motherstock Plan",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.pool_plants",
   "description": "Moved to the Motherstock Plan, which is where the line is worked out week by week. Kept so older plans and reports still read back.",
   "fieldname": "divert_weeks",
   "fieldtype": "Int",
   "hidden": 1,
   "label": "Cut Diverted For (weeks)",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.peak_cuttings",
   "description": "How many times the plantlets are multiplied before the pool is full. Suggested by the peak week and the line's life; see Multiplications Suggested for what the arithmetic asks for.",
   "fieldname": "multiplication_cycles",
   "fieldtype": "Int",
   "hidden": 0,
   "label": "Multiplications",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.pool_plants",
   "description": "The quantity the protocol's arithmetic works out. Where the order differs from it, somebody decided that; this is what they decided against.",
   "fieldname": "calculated_units",
   "fieldtype": "Int",
   "label": "What The Sum Asks For",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.pool_plants",
   "description": "The order is a person's figure, not the calculation's.",
   "fieldname": "units_overridden",
   "fieldtype": "Check",
   "label": "Quantity Set By Hand",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.pool_plants",
   "description": "The arithmetic, spelt out, so the number can be checked without reading code. The week-by-week working is on the Motherstock Plan.",
   "fieldname": "sizing_basis",
   "fieldtype": "Small Text",
   "label": "How the order was sized",
   "read_only": 1
  },
  {
   "fieldname": "column_break_totals",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "first_order_by",
   "fieldtype": "Date",
   "label": "First Order By",
   "read_only": 1
  },
  {
   "fieldname": "last_order_by",
   "fieldtype": "Date",
   "label": "Last Order By",
   "read_only": 1
  },
  {
   "fieldname": "orders_late",
   "fieldtype": "Int",
   "label": "Orders Already Late",
   "read_only": 1
  },
  {
   "description": "The material is bought once; raising it is shared out. Each unit takes what its troughs will hold, and the rest is bought in as plants.",
   "fieldname": "section_allocation",
   "fieldtype": "Section Break",
   "label": "Who Raises It"
  },
  {
   "fieldname": "propagation_allocation",
   "fieldtype": "Table",
   "label": "Propagation Allocation",
   "options": "Summer Flower Propagation Allocation"
  },
  {
   "fieldname": "section_lines",
   "fieldtype": "Section Break",
   "label": "Requirements"
  },
  {
   "fieldname": "requirements",
   "fieldtype": "Table",
   "label": "Requirements",
   "options": "Planting Material Requirement"
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "no_copy": 1,
   "options": "Summer Flower Procurement Plan",
   "print_hide": 1,
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.plants_from_order",
   "description": "Walked week by week from the quantity actually ordered, not from the one the sum suggested.",
   "fieldname": "plants_from_order",
   "fieldtype": "Int",
   "label": "Plants The Order Makes",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.plants_from_order",
   "fieldname": "order_covers_season",
   "fieldtype": "Check",
   "label": "Order Covers The Season",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.cuttings_short",
   "description": "Only a route that cuts from a pool has cuttings to be short of.",
   "fieldname": "cuttings_short",
   "fieldtype": "Int",
   "label": "Cuttings It Cannot Make",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.weeks_short",
   "description": "Sticking weeks on a route that builds a pool; planting weeks on one that buys a unit per plant.",
   "fieldname": "weeks_short",
   "fieldtype": "Int",
   "label": "Weeks Not Covered",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.plants_short",
   "fieldname": "plants_short",
   "fieldtype": "Int",
   "label": "Plants The Order Cannot Make",
   "read_only": 1
  },
  {
   "description": "Where each way in is bought. One seller takes the lot unless you say otherwise; a crop bought two ways has a line of sellers for each.",
   "fieldname": "section_purchase",
   "fieldtype": "Section Break",
   "label": "Who Sells It"
  },
  {
   "depends_on": "eval:doc.method==\"Purchase\"",
   "fieldname": "purchase_allocation",
   "fieldtype": "Table",
   "label": "Purchase Allocation",
   "options": "Summer Flower Purchase Allocation"
  }
