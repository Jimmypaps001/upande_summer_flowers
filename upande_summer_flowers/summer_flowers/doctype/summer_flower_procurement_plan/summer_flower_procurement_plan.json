   "label": "How the material is got"
  },
  {
   "fieldname": "method",
   "fieldtype": "Select",
   "label": "Method",
   "options": "Purchase\nPropagate",
   "reqd": 1
  },
  {
   "description": "The route has stages between where the material is bought and the ground, so what arrives is raised here before it is planted. Buying and propagating are not alternatives: Aster is bought as tissue culture and propagated.",
   "fieldname": "propagates_here",
   "fieldtype": "Check",
   "label": "Propagated on the farm",
   "read_only": 1
  },
  {
   "depends_on": "propagates_here",
   "description": "The stages the material passes through on the farm after it arrives.",
   "fieldname": "in_house_stages",
   "fieldtype": "Data",
   "label": "Raised here through",
   "read_only": 1
  },
  {
   "description": "Read off the material route, not chosen here. Change it on the Crop Protocol.",
   "fieldname": "route_verdict",
   "fieldtype": "Small Text",
   "label": "What the protocol says",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.method=='Purchase'",
   "fieldname": "entry_stage",
   "fieldtype": "Data",
   "label": "Bought As"
  },
  {
   "depends_on": "eval:doc.method=='Purchase'",
   "description": "Taken from Who Sells It below. Where more than one seller supplies the same way in, this stays blank and the table is the answer.",
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "Supplier",
   "options": "Supplier",
   "read_only_depends_on": "eval:(doc.purchase_allocation||[]).length"
  },
  {
   "description": "A supplier has said what they can send, week by week. The request and the order are raised from that, not from what the plan asked for.",
